{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-5">
        <h4>{{ 'Password reset'|trans }}</h4>

        {{ form_start(form, {attr: {class: 'form-signin'}}) }}
            {{ form_widget(form) }}

            <button type="submit" id="reset-password" class="btn btn-primary btn-block">
                {{ 'Change Password'|trans }}
            </button>
        {{ form_end(form) }}
    </div>
{% endblock %}
