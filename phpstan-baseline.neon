# All 29 entries here are the same root cause: $this->getUser() (and
# UserProvider's PasswordAuthenticatedUserInterface param) is typed to
# the generic Symfony interface, which doesn't expose our own
# App\Entity\User getters. Deliberately left unfixed in this PR per
# review - it's entangled with an upcoming UserProvider rework and
# will be resolved together with that, not patched around here.
parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Symfony\\Component\\Security\\Core\\User\\PasswordAuthenticatedUserInterface\:\:getCity\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/App/Security/UserProvider.php

		-
			message: '#^Call to an undefined method Symfony\\Component\\Security\\Core\\User\\PasswordAuthenticatedUserInterface\:\:getEmail\(\)\.$#'
			identifier: method.notFound
